# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public URL of this API (used in Swagger "servers")
API_URL=http://localhost:5000
# Frontend URL (used to build links inside emails)
CLIENT_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins, or * for all
CORS_ORIGIN=*

# ---------------------------------------------------------------
# Database (MongoDB)
# Prisma requires MongoDB to run as a replica set.
# MongoDB Atlas works out of the box, or use `docker compose up -d`
# with the bundled docker-compose.yml.
# ---------------------------------------------------------------
DATABASE_URL="mongodb://localhost:27017/realestate?replicaSet=rs0&directConnection=true"
# Atlas example:
# DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/realestate?retryWrites=true&w=majority"

# ---------------------------------------------------------------
# JWT
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------
# Email (SMTP)
# For local testing you can use https://ethereal.email or Mailtrap.
# ---------------------------------------------------------------
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Real Estate API <no-reply@realestate.com>"
# Set to false to log emails to the console instead of sending them
EMAIL_ENABLED=true
